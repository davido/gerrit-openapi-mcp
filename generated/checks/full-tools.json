  {
    "name": "postChangesChangeIdRevisionsRevisionIdChecksCheckIdRerun",
    "title": "Postchangeschangeidrevisionsrevisionidcheckscheckidrerun",
    "description": "Reruns a check. As response the CheckInfo entity is returned that describes the created check.",
