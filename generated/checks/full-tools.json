  {
    "name": "postChangesChangeIdRevisionsRevisionIdChecks",
    "title": "Postchangeschangeidrevisionsrevisionidchecks",
    "description": "Creates a new check.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "change-id": {
          "type": "string"
        },
        "revision-id": {
          "type": "string"
        },
        "checker_uuid": {
          "type": "string",
          "description": "The UUID of the checker. Must be specified for check creation. Optional only if updating a check and referencing the checker using the UUID in the URL."
        },
        "state": {
          "type": "string",
          "enum": [
            "FAILED",
            "NOT_STARTED",
            "SCHEDULED",
            "RUNNING",
            "SUCCESSFUL",
            "NOT_RELEVANT"
          ],
          "description": "The state as string-serialized form of CheckState"
        },
        "message": {
          "type": "string",
          "description": "Short message explaining the check state."
        },
        "url": {
          "type": "string",
          "description": "A fully-qualified URL pointing to the result of the check on the checker's infrastructure."
        },
        "started": {
          "type": "string",
          "format": "gerrit-timestamp",
          "description": "The timestamp of when the check started processing."
        },
        "finished": {
          "type": "string",
          "format": "gerrit-timestamp",
          "description": "The timestamp of when the check finished processing."
        },
        "notify": {
          "type": "string",
          "enum": [
            "NONE",
            "OWNER",
            "OWNER_REVIEWERS",
            "ALL"
          ],
          "description": "Notify handling that defines to whom email notifications should be sent when the combined check state changes due to posting this check. Allowed values are NONE, OWNER, OWNER_REVIEWERS and ALL."
        },
        "notify_details": {
          "additionalProperties": {
            "properties": {
              "accounts": {
                "items": {
                  "type": "string"
                },
                "type": "array",
                "description": "A list of account IDs that identify the accounts that should be notified."
              }
            },
            "type": "object"
          },
          "type": "object",
          "description": "Additional information about whom to notify when the combined check state changes due to posting this check as a map of recipient type to NotifyInfo entity. Regardless of this setting there are no email notifications for posting checks on non-current patch sets."
        }
      },
      "required": [
        "change-id",
        "revision-id"
      ]
    },
    "outputSchema": {
      "type": "object",
      "additionalProperties": true
    },
    "_meta": {
      "gerritOperationId": "postChangesChangeIdRevisionsRevisionIdChecks",
      "fastmcp": {
        "tags": [
          "changes"
        ]
      }
    }
  },
