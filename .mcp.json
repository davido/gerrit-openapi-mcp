{
  "mcpServers": {
    "gerrit": {
      "command": "uv",
      "args": [
        "run",
        "--project",
        "/Users/Davido/projects/gerrit-openapi-mcp",
        "gerrit-openapi-mcp",
        "serve-all",
        "--base-url",
        "https://gerrit-review.googlesource.com/a"
      ],
      "env": {
        "GERRIT_COOKIE": "${GERRIT_COOKIE:-}"
      }
    },
    "gerrit-agent": {
      "command": "uv",
      "args": [
        "run",
        "--project",
        "/Users/Davido/projects/gerrit-openapi-mcp",
        "gerrit-openapi-mcp",
        "serve-all",
        "--base-url",
        "https://gerrit-review.googlesource.com/a",
        "--core-profile",
        "agent"
      ],
      "env": {
        "GERRIT_COOKIE": "${GERRIT_COOKIE:-}"
      }
    },
    "gerrit-full": {
      "command": "uv",
      "args": [
        "run",
        "--project",
        "/Users/Davido/projects/gerrit-openapi-mcp",
        "gerrit-openapi-mcp",
        "serve-all",
        "--base-url",
        "https://gerrit-review.googlesource.com/a",
        "--core-profile",
        "full",
        "--checks-profile",
        "full",
        "--code-owners-profile",
        "full"
      ],
      "env": {
        "GERRIT_COOKIE": "${GERRIT_COOKIE:-}"
      }
    }
  }
}
